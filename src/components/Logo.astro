---
import { Image } from 'astro:assets';
import mark from '../assets/falcon-mark.png';

interface Props {
  size?: 'sm' | 'md';
}

const { size = 'md' } = Astro.props;
const px = size === 'sm' ? 32 : 36;
---

<a
  href="/"
  class="group inline-flex items-center gap-2.5 rounded-lg"
  aria-label="FalconProSec home"
>
  <Image
    src={mark}
    alt=""
    width={px}
    height={px}
    densities={[1, 2]}
    class="rounded-md"
    loading="eager"
  />
  <span
    class="font-heading text-lg font-semibold tracking-tight text-white"
    aria-hidden="true">Falcon<span class="text-primary-text">Pro</span>Sec</span
  >
</a>
