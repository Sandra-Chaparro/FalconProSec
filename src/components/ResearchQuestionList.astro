---
/**
 * Research agenda entries: the question, its area(s), whether it is being
 * investigated, and links to the investigations that take it on.
 */
import Badge from './Badge.astro';
import { getTopic, type ResearchQuestion } from '../data/taxonomy';
import { getInvestigations, investigationUrl } from '../lib/content';

interface Props {
  questions: ResearchQuestion[];
  /** Hide the area label, e.g. on a page that is already about one area. */
  showArea?: boolean;
}

const { questions, showArea = true } = Astro.props;
const investigations = await getInvestigations();
const byId = new Map(investigations.map((i) => [i.id, i]));
---

<ul class="grid gap-px overflow-hidden rounded-xl border border-line bg-line md:grid-cols-2">
  {
    questions.map((q) => {
      const linked = (q.investigations ?? []).flatMap((id) => {
        const inv = byId.get(id);
        return inv ? [inv] : [];
      });
      return (
        <li class="flex gap-3 bg-ink p-5 text-fg">
          <span class="font-mono text-primary-text" aria-hidden="true">
            ?
          </span>
          <div class="min-w-0">
            <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
              {showArea &&
                q.areas.map((slug) => (
                  <a href={`/topics/${slug}`} class="kicker hover:text-primary-text">
                    {getTopic(slug)?.label}
                  </a>
                ))}
              {q.status === 'investigating' && linked.length > 0 ? (
                <Badge tone="blue">
                  {linked.some((i) => i.data.format === 'investigation')
                    ? 'Under investigation'
                    : 'Framed in a brief'}
                </Badge>
              ) : (
                <Badge>Open</Badge>
              )}
            </div>
            <p class="mt-2 font-heading text-lg leading-snug">{q.question}</p>
            {linked.length > 0 && (
              <p class="mt-3 text-sm text-muted">
                {linked.map((inv, i) => (
                  <>
                    {i > 0 && ' · '}
                    <a href={investigationUrl(inv)} class="link">
                      {inv.data.title}
                    </a>
                  </>
                ))}
              </p>
            )}
          </div>
        </li>
      );
    })
  }
</ul>
