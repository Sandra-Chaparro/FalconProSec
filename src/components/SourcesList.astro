---
import Icon from './Icon.astro';
import { formatDate } from '../lib/content';

interface Source {
  title: string;
  url?: string;
  publisher?: string;
  accessed?: Date;
}

interface Props {
  sources: Source[];
}

const { sources } = Astro.props;
---

<section aria-labelledby="sources-heading">
  <h2 id="sources-heading" class="text-xl font-semibold">Sources</h2>
  {
    sources.length === 0 ? (
      <p class="mt-3 text-sm text-muted">No sources listed yet.</p>
    ) : (
      <ol class="mt-4 space-y-3">
        {sources.map((s, i) => (
          <li class="flex gap-3 text-sm">
            <span class="w-6 shrink-0 font-mono text-subtle">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div class="min-w-0">
              {s.url ? (
                <a
                  href={s.url}
                  class="link inline-flex items-center gap-1 break-words"
                  rel="noopener noreferrer"
                  target="_blank"
                >
                  {s.title}
                  <Icon name="external-link" size={13} />
                  <span class="sr-only">(opens in a new tab)</span>
                </a>
              ) : (
                <span class="text-fg">{s.title}</span>
              )}
              {(s.publisher || s.accessed) && (
                <p class="mt-0.5 text-subtle">
                  {s.publisher}
                  {s.publisher && s.accessed && ' · '}
                  {s.accessed && `Accessed ${formatDate(s.accessed)}`}
                </p>
              )}
            </div>
          </li>
        ))}
      </ol>
    )
  }
</section>
