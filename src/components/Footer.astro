---
import Logo from './Logo.astro';
import { FOOTER_LINKS, SITE } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line bg-surface/40">
  <div class="container-site py-14">
    <div class="grid gap-12 md:grid-cols-[1.4fr_1fr_1fr]">
      <div class="max-w-sm">
        <Logo size="sm" />
        <p class="mt-5 text-sm leading-relaxed text-muted">
          {SITE.tagline} Independent investigations and explainers on cybersecurity,
          privacy and technology.
        </p>
        <p class="mt-4 text-xs leading-relaxed text-subtle">
          Content is based on publicly available information and independent
          research. It may contain mistakes; corrections are welcome.
        </p>
      </div>
      {
        FOOTER_LINKS.map((group) => (
          <nav aria-label={group.heading}>
            <h2 class="kicker">{group.heading}</h2>
            <ul class="mt-4 space-y-3">
              {group.links.map((link) => (
                <li>
                  <a href={link.href} class="text-sm text-muted hover:text-white">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
    <div
      class="mt-12 flex flex-col gap-2 border-t border-line pt-6 text-xs text-subtle sm:flex-row sm:justify-between"
    >
      <p>© {year} {SITE.name}</p>
      <p>
        Educational content only. Not professional security or legal advice.
      </p>
    </div>
  </div>
</footer>
