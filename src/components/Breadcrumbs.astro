---
import { SITE } from '../config/site';

export interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
const all: Crumb[] = [{ label: 'Home', href: '/' }, ...items];
const site = Astro.site ?? new URL(SITE.url);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: all.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.label,
    ...(c.href ? { item: new URL(c.href, site).href } : {}),
  })),
};
---

<nav aria-label="Breadcrumb" class="mb-6">
  <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-subtle">
    {
      all.map((crumb, i) => (
        <li class="flex items-center gap-2">
          {i > 0 && <span aria-hidden="true">/</span>}
          {crumb.href && i < all.length - 1 ? (
            <a href={crumb.href} class="hover:text-white">
              {crumb.label}
            </a>
          ) : (
            <span
              aria-current={i === all.length - 1 ? 'page' : undefined}
              class="text-muted"
            >
              {crumb.label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
