---
interface Props {
  title: string;
  description?: string;
  primary: { href: string; label: string };
  secondary?: { href: string; label: string };
}

const { title, description, primary, secondary } = Astro.props;
---

<section
  class="relative overflow-hidden rounded-2xl border border-line bg-surface px-6 py-12 sm:px-12"
>
  <div class="hero-grid pointer-events-none absolute inset-0" aria-hidden="true">
  </div>
  <div class="relative max-w-2xl">
    <h2 class="text-2xl font-semibold sm:text-3xl">{title}</h2>
    {description && <p class="mt-3 text-muted">{description}</p>}
    <div class="mt-6 flex flex-wrap gap-3">
      <a href={primary.href} class="btn-primary">{primary.label}</a>
      {
        secondary && (
          <a href={secondary.href} class="btn-secondary">
            {secondary.label}
          </a>
        )
      }
    </div>
  </div>
</section>
