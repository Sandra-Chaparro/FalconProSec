---
import Icon from './Icon.astro';
import type { Term } from '../data/taxonomy';

interface Props {
  term: Term;
  href: string;
  count?: number;
  headingLevel?: 'h2' | 'h3';
}

const { term, href, count, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
---

<article class="card-interactive group relative flex h-full flex-col p-6">
  <div
    class="flex h-10 w-10 items-center justify-center rounded-lg border border-line bg-ink text-primary-text"
  >
    <Icon name={term.icon} />
  </div>
  <Heading class="mt-5 text-base font-semibold">
    <a href={href} class="stretched-link group-hover:text-primary-text">
      {term.label}
    </a>
  </Heading>
  <p class="mt-2 text-sm leading-relaxed text-muted">{term.description}</p>
  {
    count !== undefined && (
      <p class="mt-auto pt-4 font-mono text-xs text-subtle">
        {count === 0
          ? 'No articles yet'
          : `${count} ${count === 1 ? 'article' : 'articles'}`}
      </p>
    )
  }
</article>
