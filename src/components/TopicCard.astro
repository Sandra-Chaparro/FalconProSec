---
import Icon from './Icon.astro';
import type { Term } from '../data/taxonomy';

interface Props {
  term: Term;
  href: string;
  /** Published items in this category, shown as e.g. "1 investigation · 2 articles". */
  counts?: { investigations: number; articles: number };
  headingLevel?: 'h2' | 'h3';
}

const { term, href, counts, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? '' : 's'}`;
const countLabel = counts
  ? [
      counts.investigations && plural(counts.investigations, 'investigation'),
      counts.articles && plural(counts.articles, 'article'),
    ]
      .filter(Boolean)
      .join(' · ') || 'Nothing published yet'
  : undefined;
---

<article class="card-interactive group relative flex h-full flex-col p-6">
  <div
    class="flex h-10 w-10 items-center justify-center rounded-lg border border-line bg-ink text-primary-text"
  >
    <Icon name={term.icon} />
  </div>
  <Heading class="mt-5 text-base font-semibold">
    <a href={href} class="stretched-link group-hover:text-primary-text">
      {term.label}
    </a>
  </Heading>
  <p class="mt-2 text-sm leading-relaxed text-muted">{term.description}</p>
  {
    countLabel && (
      <p class="mt-auto pt-4 font-mono text-xs text-subtle">{countLabel}</p>
    )
  }
</article>
