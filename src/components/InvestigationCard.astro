---
import { Image } from 'astro:assets';
import ArticleMeta from './ArticleMeta.astro';
import { getTopic } from '../data/taxonomy';
import {
  investigationUrl,
  readingTime,
  type Investigation,
} from '../lib/content';

interface Props {
  item: Investigation;
  variant?: 'lead' | 'default';
  headingLevel?: 'h2' | 'h3';
}

const { item, variant = 'default', headingLevel = 'h3' } = Astro.props;
const { data } = item;
const Heading = headingLevel;
const topic = getTopic(data.topic);
const url = investigationUrl(item);
---

{
  variant === 'lead' ? (
    <article class="card-interactive relative grid overflow-hidden md:grid-cols-[1.1fr_1fr]">
      <div class="flex flex-col justify-between gap-8 p-6 sm:p-10">
        <div>
          <ArticleMeta
            label={`Investigation · ${topic?.label ?? data.topic}`}
            pubDate={data.pubDate}
            readingTime={readingTime(item.body)}
            draft={data.draft}
          />
          <Heading class="mt-4 text-2xl font-semibold sm:text-3xl">
            <a href={url} class="stretched-link hover:text-primary-text">
              {data.title}
            </a>
          </Heading>
          <p class="mt-4 leading-relaxed text-muted">{data.description}</p>
        </div>
        <div class="border-l-2 border-primary pl-4">
          <p class="kicker">The question</p>
          <p class="mt-1 font-serif text-lg text-fg italic">{data.question}</p>
        </div>
      </div>
      <div class="relative min-h-56 border-t border-line bg-surface-2 md:border-t-0 md:border-l">
        {data.heroImage ? (
          <Image
            src={data.heroImage}
            alt={data.heroAlt ?? ''}
            class="absolute inset-0 h-full w-full object-cover"
            widths={[480, 800, 1100]}
            sizes="(min-width: 768px) 45vw, 100vw"
          />
        ) : (
          <div class="hero-grid absolute inset-0" aria-hidden="true" />
        )}
      </div>
    </article>
  ) : (
    <article class="card-interactive relative flex h-full flex-col p-6">
      <ArticleMeta
        label={topic?.label ?? data.topic}
        pubDate={data.pubDate}
        draft={data.draft}
      />
      <Heading class="mt-3 text-lg leading-snug font-semibold">
        <a href={url} class="stretched-link hover:text-primary-text">
          {data.title}
        </a>
      </Heading>
      <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-muted">
        {data.description}
      </p>
      <p class="mt-auto pt-5 text-sm font-medium text-primary-text">
        Read investigation <span aria-hidden="true">→</span>
      </p>
    </article>
  )
}
