---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { NAV_ITEMS } from '../config/site';
import { SECTIONS } from '../data/taxonomy';
import {
  articleUrl,
  getArticles,
  getInvestigations,
  getTools,
  investigationUrl,
} from '../lib/content';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(`${href}/`);

// Client-side search index across all content types.
const [investigations, articles, tools] = await Promise.all([
  getInvestigations(),
  getArticles(),
  getTools(),
]);
const searchIndex = [
  ...investigations.map((i) => ({
    type: 'Investigation',
    title: i.data.title,
    description: i.data.description,
    url: investigationUrl(i),
    keywords: [i.data.topic, i.data.question, ...i.data.tags].join(' '),
  })),
  ...articles.map((a) => ({
    type: SECTIONS[a.data.section].label,
    title: a.data.title,
    description: a.data.description,
    url: articleUrl(a),
    keywords: [a.data.category, ...a.data.tags].join(' '),
  })),
  ...tools.map((t) => ({
    type: t.data.status === 'available' ? 'Tool' : 'Tool · Coming soon',
    title: t.data.title,
    description: t.data.summary,
    url: `/tools/${t.id}`,
    keywords: t.data.category,
  })),
];
---

<header
  class="sticky top-0 z-50 w-full border-b border-line bg-ink/85 backdrop-blur-md"
>
  <div class="container-site flex h-16 items-center justify-between gap-4">
    <Logo />

    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {
          NAV_ITEMS.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'rounded-md px-3 py-2 text-sm font-medium transition-colors',
                  isActive(item.href)
                    ? 'text-white'
                    : 'text-muted hover:text-white',
                ]}
              >
                <span
                  class:list={[
                    'border-b-2 pb-1',
                    isActive(item.href)
                      ? 'border-primary'
                      : 'border-transparent',
                  ]}
                >
                  {item.label}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-1">
      <button
        id="search-btn"
        type="button"
        class="flex items-center gap-2 rounded-lg p-2 text-muted transition-colors hover:bg-surface-2 hover:text-white"
        aria-haspopup="dialog"
        aria-controls="search-modal"
      >
        <Icon name="search" />
        <span class="sr-only">Search the site</span>
        <kbd
          class="hidden rounded border border-line px-1.5 font-mono text-[10px] text-subtle xl:inline"
          aria-hidden="true">⌘K</kbd
        >
      </button>
      <button
        id="mobile-menu-btn"
        type="button"
        class="rounded-lg p-2 text-muted transition-colors hover:bg-surface-2 hover:text-white lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" size={22} />
        <span class="sr-only">Open menu</span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile menu -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-[60] hidden lg:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Site menu"
>
  <div
    id="mobile-menu-backdrop"
    class="absolute inset-0 bg-ink/70 opacity-0 backdrop-blur-sm transition-opacity duration-300"
  >
  </div>
  <div
    id="mobile-menu-panel"
    class="absolute top-0 right-0 bottom-0 flex w-[300px] max-w-[85vw] translate-x-full flex-col border-l border-line bg-surface p-6 transition-transform duration-300 ease-out"
  >
    <div class="mb-8 flex items-center justify-between">
      <span class="kicker">Menu</span>
      <button
        id="mobile-menu-close"
        type="button"
        class="rounded-lg p-2 text-muted hover:bg-surface-2 hover:text-white"
      >
        <Icon name="x" size={22} />
        <span class="sr-only">Close menu</span>
      </button>
    </div>
    <nav aria-label="Mobile">
      <ul class="flex flex-col">
        {
          NAV_ITEMS.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'block border-b border-line py-3 text-base font-medium',
                  isActive(item.href)
                    ? 'text-primary-text'
                    : 'text-fg hover:text-white',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</div>

<!-- Search dialog -->
<div
  id="search-modal"
  class="fixed inset-0 z-[100] hidden"
  role="dialog"
  aria-modal="true"
  aria-labelledby="search-label"
>
  <div id="search-backdrop" class="absolute inset-0 bg-ink/75 backdrop-blur-sm">
  </div>
  <div
    class="pointer-events-none absolute inset-x-0 top-0 flex justify-center px-4 pt-20 sm:px-6"
  >
    <div
      class="pointer-events-auto w-full max-w-2xl overflow-hidden rounded-2xl border border-line bg-surface shadow-2xl"
    >
      <div class="relative border-b border-line p-4">
        <label id="search-label" for="search-input" class="sr-only"
          >Search investigations, articles and tools</label
        >
        <Icon
          name="search"
          class="absolute top-1/2 left-8 -translate-y-1/2 text-subtle"
        />
        <input
          type="search"
          id="search-input"
          placeholder="Search investigations, articles, tools…"
          class="w-full rounded-xl border border-transparent bg-ink py-3 pr-16 pl-12 text-fg outline-none placeholder:text-subtle focus:border-primary/50"
          autocomplete="off"
          aria-controls="search-results"
        />
        <span
          class="absolute top-1/2 right-8 -translate-y-1/2 rounded border border-line px-1.5 py-0.5 font-mono text-[10px] text-subtle"
          aria-hidden="true">Esc</span
        >
      </div>
      <div
        id="search-results"
        class="custom-scrollbar max-h-[60vh] space-y-1 overflow-y-auto p-2"
      >
      </div>
      <div
        class="flex items-center justify-between border-t border-line bg-ink px-4 py-2 font-mono text-[11px] text-subtle"
      >
        <span>Search</span>
        <span id="results-count" role="status" aria-live="polite"></span>
      </div>
    </div>
  </div>
</div>

<script is:inline type="application/json" id="search-index" set:html={JSON.stringify(searchIndex)} />

<script>
  interface SearchItem {
    type: string;
    title: string;
    description: string;
    url: string;
    keywords: string;
  }

  const index: SearchItem[] = JSON.parse(
    document.getElementById('search-index')?.textContent ?? '[]'
  );

  const searchBtn = document.getElementById('search-btn');
  const searchModal = document.getElementById('search-modal')!;
  const searchBackdrop = document.getElementById('search-backdrop');
  const searchInput = document.getElementById(
    'search-input'
  ) as HTMLInputElement;
  const searchResults = document.getElementById('search-results')!;
  const resultsCount = document.getElementById('results-count')!;

  const escapeHtml = (s: string) =>
    s.replace(
      /[&<>"']/g,
      (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[
          c
        ]!
    );

  let lastFocused: HTMLElement | null = null;

  function openSearch() {
    lastFocused = document.activeElement as HTMLElement;
    searchModal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    renderResults();
    setTimeout(() => searchInput.focus(), 20);
  }

  function closeSearch() {
    searchModal.classList.add('hidden');
    document.body.style.overflow = '';
    searchInput.value = '';
    lastFocused?.focus();
  }

  function renderResults() {
    const query = searchInput.value.toLowerCase().trim();
    if (!query) {
      searchResults.innerHTML = `<p class="py-10 text-center text-sm text-subtle">${
        index.length
          ? 'Start typing to search.'
          : 'Nothing has been published yet. Investigations and articles will appear here.'
      }</p>`;
      resultsCount.textContent = '';
      return;
    }

    const words = query.split(/\s+/);
    const results = index.filter((item) => {
      const haystack =
        `${item.title} ${item.description} ${item.type} ${item.keywords}`.toLowerCase();
      return words.every((w) => haystack.includes(w));
    });

    resultsCount.textContent = `${results.length} result${results.length === 1 ? '' : 's'}`;

    if (!results.length) {
      searchResults.innerHTML = `<p class="py-10 text-center text-sm text-subtle">No results for “${escapeHtml(searchInput.value)}”.</p>`;
      return;
    }

    searchResults.innerHTML = results
      .map(
        (r) => `
        <a href="${r.url}" class="block rounded-xl border border-transparent p-4 hover:border-line hover:bg-surface-2 focus:border-line focus:bg-surface-2">
          <span class="kicker !text-primary-text">${escapeHtml(r.type)}</span>
          <span class="mt-1 block font-semibold text-white">${escapeHtml(r.title)}</span>
          <span class="mt-1 block line-clamp-1 text-sm text-muted">${escapeHtml(r.description)}</span>
        </a>`
      )
      .join('');
  }

  searchBtn?.addEventListener('click', openSearch);
  searchBackdrop?.addEventListener('click', closeSearch);
  searchInput?.addEventListener('input', renderResults);

  // Mobile menu
  const menuBtn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu')!;
  const menuBackdrop = document.getElementById('mobile-menu-backdrop')!;
  const menuPanel = document.getElementById('mobile-menu-panel')!;
  const menuClose = document.getElementById('mobile-menu-close');
  let menuOpen = false;

  function setMenu(open: boolean) {
    menuOpen = open;
    menuBtn?.setAttribute('aria-expanded', String(open));
    if (open) {
      menu.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => {
        menuBackdrop.classList.add('opacity-100');
        menuPanel.classList.remove('translate-x-full');
      });
      setTimeout(() => menuClose?.focus(), 50);
    } else {
      menuBackdrop.classList.remove('opacity-100');
      menuPanel.classList.add('translate-x-full');
      document.body.style.overflow = '';
      setTimeout(() => menu.classList.add('hidden'), 300);
      menuBtn?.focus();
    }
  }

  menuBtn?.addEventListener('click', () => setMenu(true));
  menuClose?.addEventListener('click', () => setMenu(false));
  menuBackdrop.addEventListener('click', () => setMenu(false));

  // Keep keyboard focus inside whichever dialog is open.
  function trapFocus(container: HTMLElement, e: KeyboardEvent) {
    const focusable = container.querySelectorAll<HTMLElement>(
      'a[href], button, input, [tabindex]:not([tabindex="-1"])'
    );
    if (!focusable.length) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];
    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  }

  window.addEventListener('keydown', (e) => {
    const searchOpen = !searchModal.classList.contains('hidden');
    if (e.key === 'k' && (e.metaKey || e.ctrlKey)) {
      e.preventDefault();
      if (searchOpen) closeSearch();
      else openSearch();
      return;
    }
    if (e.key === 'Escape') {
      if (searchOpen) closeSearch();
      else if (menuOpen) setMenu(false);
    }
    if (e.key === 'Tab') {
      if (searchOpen) trapFocus(searchModal, e);
      else if (menuOpen) trapFocus(menuPanel, e);
    }
  });
</script>
