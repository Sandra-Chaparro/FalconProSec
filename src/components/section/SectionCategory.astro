---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../ArticleCard.astro';
import InvestigationCard from '../InvestigationCard.astro';
import SectionHeader from '../SectionHeader.astro';
import EmptyState from '../EmptyState.astro';
import PageHeader from '../PageHeader.astro';
import { SECTIONS, type SectionSlug, type Term } from '../../data/taxonomy';
import { getArticles, getInvestigations } from '../../lib/content';

interface Props {
  section: SectionSlug;
  category: Term;
}

const { section: slug, category } = Astro.props;
const section = SECTIONS[slug];
const articles = (await getArticles(slug)).filter(
  (a) => a.data.category === category.slug
);
const investigations = (await getInvestigations()).filter((i) =>
  i.data.categories.includes(category.slug)
);
---

<Layout
  title={`${category.label} — ${section.label}`}
  description={`${category.description} Investigations and articles on ${category.label.toLowerCase()} from the ${section.label} section.`}
>
  <PageHeader
    kicker={section.label}
    title={category.label}
    description={category.description}
    breadcrumbs={[
      { label: section.label, href: `/${slug}` },
      { label: category.label },
    ]}
  />
  <div class="container-site mt-12 space-y-16">
    {
      investigations.length === 0 && articles.length === 0 ? (
        <EmptyState
          icon="book"
          title={`Nothing on ${category.label} yet`}
          description="Investigations and articles in this category will appear here once published."
          action={{ href: `/${slug}`, label: `Back to ${section.label}` }}
        />
      ) : (
        <>
          {investigations.length > 0 && (
            <section aria-labelledby="inv-heading">
              <SectionHeader id="inv-heading" title="Investigations" />
              <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                {investigations.map((item) => (
                  <InvestigationCard item={item} />
                ))}
              </div>
            </section>
          )}
          {articles.length > 0 && (
            <section aria-labelledby="art-heading">
              <SectionHeader id="art-heading" title="Articles" />
              <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                {articles.map((a) => (
                  <ArticleCard article={a} />
                ))}
              </div>
            </section>
          )}
        </>
      )
    }
  </div>
</Layout>
