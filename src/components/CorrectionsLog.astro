---
import { formatDate, isoDate } from '../lib/content';

interface Props {
  corrections: { date: Date; note: string }[];
}

const { corrections } = Astro.props;
---

{
  corrections.length > 0 && (
    <section
      aria-labelledby="corrections-heading"
      class="rounded-xl border border-amber/30 bg-amber/5 p-6"
    >
      <h2 id="corrections-heading" class="text-lg font-semibold">
        Corrections & updates
      </h2>
      <ul class="mt-3 space-y-2">
        {corrections.map((c) => (
          <li class="text-sm text-muted">
            <time
              datetime={isoDate(c.date)}
              class="mr-2 font-mono text-xs text-amber"
            >
              {formatDate(c.date)}
            </time>
            {c.note}
          </li>
        ))}
      </ul>
    </section>
  )
}
