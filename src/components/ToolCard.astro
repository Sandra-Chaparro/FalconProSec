---
import Badge from './Badge.astro';
import Icon, { type IconName } from './Icon.astro';
import type { Tool } from '../lib/content';

interface Props {
  tool: Tool;
  headingLevel?: 'h2' | 'h3';
}

const { tool, headingLevel = 'h3' } = Astro.props;
const { data } = tool;
const Heading = headingLevel;
const available = data.status === 'available';
const icon = data.icon as IconName;
---

<article
  class:list={[
    'relative flex h-full flex-col p-6',
    available ? 'card-interactive' : 'card border-dashed',
  ]}
>
  <div class="flex items-start justify-between gap-3">
    <div
      class:list={[
        'flex h-10 w-10 items-center justify-center rounded-lg border border-line bg-ink',
        available ? 'text-primary-text' : 'text-subtle',
      ]}
    >
      <Icon name={icon} />
    </div>
    {
      available ? (
        <Badge tone="blue">Available</Badge>
      ) : (
        <Badge tone="amber">Coming soon</Badge>
      )
    }
  </div>
  <p class="kicker mt-5">{data.category}</p>
  <Heading class="mt-1.5 text-lg font-semibold">
    <a
      href={`/tools/${tool.id}`}
      class="stretched-link hover:text-primary-text"
    >
      {data.title}
    </a>
  </Heading>
  <p class="mt-2 text-sm leading-relaxed text-muted">{data.summary}</p>
  <p
    class:list={[
      'mt-auto pt-5 text-sm font-medium',
      available ? 'text-primary-text' : 'text-subtle',
    ]}
  >
    {
      available ? (
        <>
          Open tool <span aria-hidden="true">→</span>
        </>
      ) : (
        'In development — not yet functional'
      )
    }
  </p>
</article>
