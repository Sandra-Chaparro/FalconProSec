---
import ArticleMeta from './ArticleMeta.astro';
import { getCategory, SECTIONS } from '../data/taxonomy';
import { articleUrl, readingTime, type Article } from '../lib/content';

interface Props {
  article: Article;
  headingLevel?: 'h2' | 'h3';
  showSection?: boolean;
}

const { article, headingLevel = 'h3', showSection = false } = Astro.props;
const { data } = article;
const Heading = headingLevel;
const category = getCategory(data.section, data.category);
const label = showSection
  ? SECTIONS[data.section].label
  : (category?.label ?? data.category);
---

<article class="card-interactive relative flex h-full flex-col p-6">
  <ArticleMeta
    label={label}
    pubDate={data.pubDate}
    readingTime={readingTime(article.body)}
    draft={data.draft}
  />
  <Heading class="mt-3 text-lg leading-snug font-semibold">
    <a href={articleUrl(article)} class="stretched-link hover:text-primary-text">
      {data.title}
    </a>
  </Heading>
  <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-muted">
    {data.description}
  </p>
</article>
