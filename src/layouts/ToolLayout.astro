---
import Layout from './Layout.astro';
import Badge from '../components/Badge.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Disclaimer from '../components/Disclaimer.astro';
import Icon, { type IconName } from '../components/Icon.astro';
import InvestigationQuestion from '../components/InvestigationQuestion.astro';
import { getTopic } from '../data/taxonomy';
import { findingUrl, investigationUrl, type Tool } from '../lib/content';
import { getEntry } from 'astro:content';

interface Props {
  tool: Tool;
}

const { tool } = Astro.props;
const { data } = tool;
const available = data.status === 'available';
const area = getTopic(data.area);
const visible = <T extends { data: { draft: boolean } }>(e: T | undefined) =>
  e && (import.meta.env.DEV || !e.data.draft) ? e : undefined;
const investigation = visible(
  data.investigation ? await getEntry(data.investigation) : undefined
);
const finding = visible(data.finding ? await getEntry(data.finding) : undefined);
---

<Layout
  title={data.title}
  description={data.summary}
  noindex={!available}
>
  <section class="relative overflow-hidden border-b border-line">
    <div class="hero-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
    <div class="container-site relative py-12 sm:py-16">
      <Breadcrumbs items={[{ label: 'Tools', href: '/tools' }, { label: data.title }]} />
      <div class="flex flex-wrap items-center gap-3">
        <span class="kicker">{data.kind} · {area?.label ?? data.category}</span>
        {
          available ? (
            <Badge tone="blue">Available</Badge>
          ) : (
            <Badge tone="amber">Coming soon</Badge>
          )
        }
      </div>
      <h1 class="mt-4 max-w-3xl text-4xl font-semibold sm:text-5xl">
        {data.title}
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-muted">
        {data.summary}
      </p>
      {
        data.question && (
          <div class="mt-8 max-w-3xl">
            <InvestigationQuestion label="The question behind it" question={data.question} />
          </div>
        )
      }
    </div>
  </section>

  <div class="container-site mt-12">
    {
      available ? (
        <slot />
      ) : (
        <div class="card flex flex-col gap-6 border-dashed p-8 sm:flex-row sm:items-start">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg border border-line bg-ink text-amber">
            <Icon name={data.icon as IconName} size={24} />
          </div>
          <div>
            <h2 class="text-xl font-semibold">This tool is in development</h2>
            <p class="mt-2 max-w-2xl leading-relaxed text-muted">
              It isn’t functional yet. This page describes the question behind
              it and what it is intended to do. If you have ideas for what would
              make it genuinely useful to people, suggestions are welcome.
            </p>
            <div class="mt-6 flex flex-wrap gap-3">
              <a href="/tools" class="btn-secondary">
                <Icon name="arrow-left" size={16} /> All tools
              </a>
              <a href="/contact?reason=feedback" class="btn-secondary">
                Suggest a feature
              </a>
            </div>
          </div>
        </div>
      )
    }

    <section class="mt-12 max-w-3xl rounded-xl border border-line bg-surface p-6" aria-labelledby="origin-heading">
      <h2 id="origin-heading" class="text-base font-semibold text-white">Why this was built</h2>
      <dl class="mt-4 space-y-3 text-sm">
        {
          area && (
            <div class="flex flex-wrap gap-x-2">
              <dt class="text-subtle">Area of inquiry:</dt>
              <dd>
                <a href={`/topics/${area.slug}`} class="link">{area.label}</a>
              </dd>
            </div>
          )
        }
        {
          investigation && (
            <div class="flex flex-wrap gap-x-2">
              <dt class="text-subtle">Prompted by the investigation:</dt>
              <dd>
                <a href={investigationUrl(investigation)} class="link">
                  {investigation.data.title}
                </a>
              </dd>
            </div>
          )
        }
        {
          finding && (
            <div class="flex flex-wrap gap-x-2">
              <dt class="text-subtle">Tests the finding:</dt>
              <dd>
                <a href={findingUrl(finding)} class="link">{finding.data.title}</a>
              </dd>
            </div>
          )
        }
      </dl>
      <p class="mt-4 text-sm leading-relaxed text-muted">
        {
          investigation || finding
            ? 'It exists to examine a question the research raised, not to demonstrate a technique.'
            : 'It starts from a question on the research agenda. It is not yet linked to a published investigation; when one gives it a sharper purpose, the link will appear here.'
        }{' '}
        Tools are educational and experimental, not a replacement for a
        professional security assessment, and each one explains how it handles
        anything you enter.
      </p>
    </section>
    <div class="mt-8 max-w-3xl">
      <Disclaimer variant="compact" />
    </div>
  </div>
</Layout>
