---
import Layout from '../../layouts/Layout.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import PageHeader from '../../components/PageHeader.astro';
import ToolCard from '../../components/ToolCard.astro';
import { getTools } from '../../lib/content';

const tools = await getTools();
const available = tools.filter((t) => t.data.status === 'available');
const upcoming = tools.filter((t) => t.data.status !== 'available');
---

<Layout
  title="Tools"
  description="Experiments, simulators and educational tools built to investigate questions from FalconProSec's research, each linked to the question that prompted it."
>
  <PageHeader
    kicker="Tools"
    title="Built to investigate"
    description="Some questions can only be understood by building something: an experiment, a simulator, a visualization, a prototype. Each tool here exists because a research question created a reason for it, and it is linked to that question. Tools are not built to demonstrate technical ability."
  >
    <ol
      class="mt-8 flex flex-wrap items-center gap-x-2 gap-y-2 font-mono text-xs tracking-wide text-subtle uppercase"
      aria-label="Where tools come from"
    >
      <li>Investigation</li>
      <li class="text-primary-text" aria-hidden="true">→</li>
      <li>Finding or question</li>
      <li class="text-primary-text" aria-hidden="true">→</li>
      <li>Experiment or tool</li>
    </ol>
  </PageHeader>

  <div class="container-site mt-12 space-y-16">
    {
      available.length > 0 && (
        <section aria-labelledby="available-heading">
          <h2 id="available-heading" class="mb-6 text-2xl font-semibold">
            Available now
          </h2>
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {available.map((tool) => (
              <ToolCard tool={tool} />
            ))}
          </div>
        </section>
      )
    }

    <section aria-labelledby="upcoming-heading">
      <h2 id="upcoming-heading" class="text-2xl font-semibold">In development</h2>
      <p class="mt-2 mb-6 max-w-2xl text-muted">
        Planned instruments, each starting from a question on the research
        agenda. None is functional yet, and each is marked “Coming soon” until
        it is. Their scope may change as investigations sharpen the questions
        behind them.
      </p>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {upcoming.map((tool) => <ToolCard tool={tool} />)}
      </div>
    </section>

    <Disclaimer variant="compact" />
  </div>
</Layout>
