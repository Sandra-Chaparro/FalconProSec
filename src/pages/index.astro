---
import Layout from '../layouts/Layout.astro';
import AsciiHero from '../components/AsciiHero.astro';
import Badge from '../components/Badge.astro';
import CTASection from '../components/CTASection.astro';
import Disclaimer from '../components/Disclaimer.astro';
import EmptyState from '../components/EmptyState.astro';
import FindingCard from '../components/FindingCard.astro';
import KnowledgeLoop from '../components/KnowledgeLoop.astro';
import ResearchQuestionList from '../components/ResearchQuestionList.astro';
import Icon from '../components/Icon.astro';
import InvestigationCard from '../components/InvestigationCard.astro';
import InvestigationQuestion from '../components/InvestigationQuestion.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ToolCard from '../components/ToolCard.astro';
import TopicCard from '../components/TopicCard.astro';
import { SITE } from '../config/site';
import { RESEARCH_QUESTIONS, TOPICS, type Term } from '../data/taxonomy';
import { getFindings, getInvestigations, getTools, pickFeatured } from '../lib/content';
import { siteJsonLd } from '../lib/seo';

// Phrases cycled in the hero's "investigating:" line.
const signals = (TOPICS as readonly Term[]).map(
  (t) => t.signal ?? t.label.toLowerCase()
);

const investigations = await getInvestigations();
const featured = pickFeatured(investigations);
const latest = investigations.filter((i) => i !== featured).slice(0, 6);

const findings = (await getFindings()).slice(0, 3);
const agenda = [
  ...RESEARCH_QUESTIONS.filter((q) => q.status === 'investigating'),
  ...RESEARCH_QUESTIONS.filter((q) => q.status === 'open'),
].slice(0, 4);

const tools = await getTools();
const featuredTool =
  tools.find((t) => t.data.status === 'available' && t.data.featured) ??
  tools.find((t) => t.data.status === 'available') ??
  tools.find((t) => t.data.featured);
---

<Layout description={SITE.description} jsonLd={siteJsonLd()}>
  <!-- Hero -->
  <section class="relative overflow-hidden border-b border-line">
    <AsciiHero />
    <div
      class="container-site relative flex min-h-[calc(100svh-4rem)] flex-col justify-between gap-16 py-16 sm:py-20 lg:min-h-[44rem]"
    >
      <h1 class="sr-only">
        Technology is powerful. What matters is what we use it for.
        As technology becomes more powerful, protecting people becomes more important.
      </h1>

      <div class="max-w-4xl">
        <p class="kicker !text-primary-text" data-type data-type-delay="200">
          Technology · AI · Security · Human impact
        </p>
        <p
          class="hero-title mt-6 text-4xl sm:text-5xl lg:text-6xl"
          aria-hidden="true"
        >
          <span class="block">As technology becomes more powerful,</span>
          <span class="mt-2 block !text-primary-text"
            ><span data-type data-type-delay="900" data-type-caret
              >protecting people becomes more important.</span
            ></span
          >
        </p>
        <p class="mt-8 max-w-md leading-relaxed text-muted sm:text-lg">
          An independent research project on how technology puts people at
          risk: exposing emerging threats, testing how they work, and turning
          findings into guidance people can use to defend themselves.
        </p>
        <p class="mt-6 font-mono text-xs text-subtle sm:text-sm">
          <span class="text-primary-text">&gt;</span> investigating:
          <span
            class="text-fg"
            data-cycle={JSON.stringify(signals)}
            >{signals[0]}</span
          ><span class="type-caret" aria-hidden="true"></span>
        </p>
      </div>

      <div class="flex flex-col items-start lg:items-end">
        <div class="flex flex-wrap gap-3">
          <a href="/investigations" class="btn-primary">
            Explore Investigations <Icon name="arrow-right" size={16} />
          </a>
          <a href="/about" class="btn-secondary">Why FalconProSec exists</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Central question -->
  <section class="container-site mt-20" aria-labelledby="question-heading">
    <h2 id="question-heading" class="sr-only">The question behind this site</h2>
    <div class="grid gap-8 lg:grid-cols-[1.2fr_1fr] lg:items-center">
      <InvestigationQuestion
        label="The question behind FalconProSec"
        question="How can technology be used to solve human problems and protect people as AI changes society?"
      />
      <div class="space-y-4 leading-relaxed text-muted">
        <p>
          The focus isn't technology for its own sake. It's what happens when
          technology reaches real people: who it protects, who it exposes, and
          who it leaves out.
        </p>
        <p>
          Many of these problems don't have a clear job title yet. FalconProSec
          follows the problem, not the title, and uses whatever discipline the
          question needs.
        </p>
      </div>
    </div>
  </section>

  <!-- How knowledge builds -->
  <section class="container-site mt-24" aria-labelledby="loop-heading">
    <SectionHeader
      id="loop-heading"
      kicker="How it works"
      title="Each investigation should leave something to build on"
      description="Investigations are not published for their own sake. Each one is meant to add evidence, sharpen a pattern or open a better question, so that the work accumulates into knowledge."
      link={{ href: '/methods', label: 'Methods' }}
    />
    <KnowledgeLoop />
  </section>

  <!-- Featured investigation -->
  <section class="container-site mt-20" aria-labelledby="featured-heading">
    <SectionHeader
      id="featured-heading"
      kicker={featured?.data.format === 'brief' ? 'Featured brief' : 'Featured investigation'}
      title="Asking a question, then following the evidence"
      link={{ href: '/investigations', label: 'All investigations' }}
    />
    {
      featured ? (
        <InvestigationCard item={featured} variant="lead" />
      ) : (
        <article class="card relative grid overflow-hidden border-dashed md:grid-cols-[1.1fr_1fr]">
          <div class="flex flex-col gap-6 p-6 sm:p-10">
            <div class="flex items-center gap-3">
              <Badge tone="amber">In progress</Badge>
              <span class="kicker">Investigation</span>
            </div>
            <h3 class="text-2xl font-semibold text-muted sm:text-3xl">
              The first investigation is underway
            </h3>
            <p class="leading-relaxed text-subtle">
              Each one starts with a question, works through the evidence and
              ends with what it means for people. It will appear here once it
              is ready to publish.
            </p>
          </div>
          <div
            class="relative min-h-48 border-t border-line bg-surface-2 md:border-t-0 md:border-l"
          >
            <div class="hero-grid absolute inset-0" aria-hidden="true"></div>
          </div>
        </article>
      )
    }
  </section>

  <!-- Topics -->
  <section class="container-site mt-24" aria-labelledby="topics-heading">
    <SectionHeader
      id="topics-heading"
      kicker="Areas of inquiry"
      title="What FalconProSec is trying to understand"
      description="Five research directions defined by human problems rather than specialties. Each draws on whichever disciplines the question needs: cybersecurity, software engineering, AI, psychology or behavioral science."
      link={{ href: '/research', label: 'Research' }}
    />
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        TOPICS.map((topic) => (
          <TopicCard term={topic} href={`/topics/${topic.slug}`} />
        ))
      }
    </div>
  </section>

  <!-- Research agenda -->
  <section class="container-site mt-24" aria-labelledby="agenda-heading">
    <SectionHeader
      id="agenda-heading"
      kicker="Research agenda"
      title="Questions currently being explored"
      description="Most do not have answers yet. When an investigation takes one on, it is linked here."
      link={{ href: '/research#agenda-heading', label: 'Full agenda' }}
    />
    <ResearchQuestionList questions={agenda} />
  </section>

  <!-- Findings -->
  <section class="container-site mt-24" aria-labelledby="findings-heading">
    <SectionHeader
      id="findings-heading"
      kicker="Findings"
      title="What the investigations add up to"
      description="Findings document what can be concluded when evidence holds across several investigations, with evidence, interpretation and hypothesis kept separate."
      link={{ href: '/findings', label: 'About findings' }}
    />
    {
      findings.length > 0 ? (
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {findings.map((f) => (
            <FindingCard item={f} />
          ))}
        </div>
      ) : (
        <div class="card border-dashed p-6 sm:p-8">
          <p class="max-w-2xl leading-relaxed text-muted">
            No findings have been published yet. The first findings will be
            written when evidence from several investigations points the same
            way.
          </p>
        </div>
      )
    }
  </section>

  <!-- Featured tool -->
  <section class="container-site mt-24" aria-labelledby="tool-heading">
    <div
      class="grid gap-8 rounded-2xl border border-line bg-surface/50 p-6 sm:p-10 lg:grid-cols-[1fr_1.1fr] lg:items-center"
    >
      <div>
        <p class="kicker !text-primary-text">Tools</p>
        <h2 id="tool-heading" class="mt-3 text-2xl font-semibold sm:text-3xl">
          Built to investigate
        </h2>
        <p class="mt-3 leading-relaxed text-muted">
          Some questions can only be understood by building something: an
          experiment, a simulator, a prototype. Each tool starts from a
          research question and is linked to it. They are built one at a time,
          and each is clearly marked until it works.
        </p>
        <a href="/tools" class="link mt-5 inline-block text-sm">
          See all tools
        </a>
      </div>
      {featuredTool && <ToolCard tool={featuredTool} />}
    </div>
  </section>

  <!-- Latest investigations -->
  <section class="container-site mt-24" aria-labelledby="latest-heading">
    <SectionHeader
      id="latest-heading"
      kicker="Latest"
      title="Latest investigations"
      link={latest.length
        ? { href: '/investigations', label: 'View all' }
        : undefined}
    />
    {
      latest.length ? (
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {latest.map((item) => (
            <InvestigationCard item={item} />
          ))}
        </div>
      ) : (
        <EmptyState
          icon="search"
          title="Investigations are in progress"
          description="Published investigations will be listed here. Is there a question about technology and people you think deserves a closer look?"
          action={{
            href: '/contact?reason=investigation',
            label: 'Suggest a question',
          }}
        />
      )
    }
  </section>

  <!-- About the site -->
  <section class="container-site mt-24" aria-labelledby="about-heading">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.3fr]">
      <div>
        <p class="kicker !text-primary-text">About</p>
        <h2 id="about-heading" class="mt-3 text-2xl font-semibold sm:text-3xl">
          Small today, with a clear direction
        </h2>
      </div>
      <div class="space-y-4 text-lg leading-relaxed text-muted">
        <p>
          AI can now produce a convincing voice, face or message almost for
          free, and the systems people depend on are increasingly automated.
          Many of the risks that follow cannot be understood through technology
          alone.
        </p>
        <p>
          FalconProSec is currently an independent research initiative. Its
          long-term direction is a multidisciplinary research organisation,
          one that grows out of the work: accumulated findings, a tested
          method, and collaboration with people from other fields.
        </p>
        <a href="/about" class="link inline-block text-base">
          About FalconProSec
        </a>
      </div>
    </div>
  </section>

  <!-- Method + disclaimer -->
  <section class="container-site mt-24 space-y-8">
    <CTASection
      title="Have a question worth investigating?"
      description="Especially one about how technology affects people. Suggestions, corrections and added context are always welcome."
      primary={{
        href: '/contact?reason=investigation',
        label: 'Suggest a question',
      }}
      secondary={{ href: '/methods', label: 'How investigations work' }}
    />
    <Disclaimer />
  </section>
</Layout>

<script>
  // Typewriter effects for the hero. The full text is in the HTML, so the page
  // reads correctly without JavaScript or with reduced motion.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduceMotion) {
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

    // The untyped remainder stays in place but invisible, so lines don't
    // reflow while typing.
    document.querySelectorAll<HTMLElement>('[data-type]').forEach(async (el) => {
      const text = el.textContent?.trim() ?? '';
      const typed = document.createElement('span');
      const rest = document.createElement('span');
      rest.style.visibility = 'hidden';
      rest.textContent = text;
      el.replaceChildren(typed);
      if (el.hasAttribute('data-type-caret')) {
        const caret = document.createElement('span');
        caret.className = 'type-caret';
        el.append(caret);
      }
      el.append(rest);
      await sleep(Number(el.dataset.typeDelay ?? 0));
      for (let i = 1; i <= text.length; i++) {
        typed.textContent = text.slice(0, i);
        rest.textContent = text.slice(i);
        await sleep(text[i - 1] === ' ' ? 30 : 30 + Math.random() * 50);
      }
    });

    document.querySelectorAll<HTMLElement>('[data-cycle]').forEach(async (el) => {
      const words: string[] = JSON.parse(el.dataset.cycle ?? '[]');
      let i = 0;
      await sleep(2500);
      for (;;) {
        await sleep(3200);
        while (el.textContent) {
          el.textContent = el.textContent.slice(0, -1);
          await sleep(25);
        }
        i = (i + 1) % words.length;
        for (const ch of words[i]) {
          el.textContent += ch;
          await sleep(45 + Math.random() * 40);
        }
      }
    });
  }
</script>
