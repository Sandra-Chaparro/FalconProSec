---
import Layout from '../../layouts/Layout.astro';
import CTASection from '../../components/CTASection.astro';
import Icon from '../../components/Icon.astro';
import PageHeader from '../../components/PageHeader.astro';
import ResearchQuestionList from '../../components/ResearchQuestionList.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { RESEARCH_QUESTIONS, TOPICS } from '../../data/taxonomy';
import { getFindings, getInvestigations } from '../../lib/content';

const [investigations, findings] = await Promise.all([
  getInvestigations(),
  getFindings(),
]);
const countFor = (slug: string) => ({
  investigations: investigations.filter((i) => i.data.topic === slug).length,
  findings: findings.filter((f) => (f.data.areas as string[]).includes(slug)).length,
});
const active = RESEARCH_QUESTIONS.filter((q) => q.status === 'investigating');
const open = RESEARCH_QUESTIONS.filter((q) => q.status === 'open');
const plural = (n: number, w: string) => `${n} ${w}${n === 1 ? '' : 's'}`;
---

<Layout
  title="Research"
  description="FalconProSec's areas of inquiry and research agenda: the questions being explored where technology, cybersecurity, AI and human behavior meet."
>
  <PageHeader
    kicker="Research"
    title="What FalconProSec is trying to understand"
    description="Five areas of inquiry, each defined by a question rather than a specialty, and a research agenda of the specific questions being explored. Most of these questions do not have answers yet. That is the point of asking them."
  />

  <div class="container-site mt-16 space-y-24">
    <section aria-labelledby="areas-heading">
      <SectionHeader
        id="areas-heading"
        kicker="Areas of inquiry"
        title="Five directions, one subject: people"
        description="These areas overlap, and the boundaries are expected to move as investigations reveal connections. Each one draws on whichever disciplines the question needs."
      />
      <ul class="space-y-4">
        {
          TOPICS.map((t) => {
            const c = countFor(t.slug);
            return (
              <li class="card-interactive relative grid gap-6 p-6 sm:p-8 lg:grid-cols-[1fr_1.6fr]">
                <div class="flex items-start gap-4">
                  <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-lg border border-line bg-surface-2 text-primary-text">
                    <Icon name={t.icon} size={22} />
                  </span>
                  <div>
                    <h3 class="text-xl font-semibold">
                      <a href={`/topics/${t.slug}`} class="stretched-link hover:text-primary-text">
                        {t.label}
                      </a>
                    </h3>
                    <p class="mt-2 font-mono text-xs text-subtle">
                      {c.investigations || c.findings
                        ? [
                            c.investigations && plural(c.investigations, 'investigation'),
                            c.findings && plural(c.findings, 'finding'),
                          ]
                            .filter(Boolean)
                            .join(' · ')
                        : 'No published work yet'}
                    </p>
                  </div>
                </div>
                <div>
                  <p class="font-heading text-lg leading-snug text-fg">{t.inquiry}</p>
                  <p class="mt-3 text-sm leading-relaxed text-muted">{t.description}</p>
                  <p class="mt-4 font-mono text-xs text-subtle">
                    Draws on: {t.disciplines.join(' · ')}
                  </p>
                </div>
              </li>
            );
          })
        }
      </ul>
    </section>

    <section aria-labelledby="agenda-heading">
      <SectionHeader
        id="agenda-heading"
        kicker="Research agenda"
        title="Questions currently being explored"
        description="An active agenda, not a list of answers. When an investigation takes on a question, it is linked here. When it leaves something unresolved, that becomes a new question."
      />
      {
        active.length > 0 && (
          <div class="mb-10">
            <h3 class="kicker mb-4">Under investigation</h3>
            <ResearchQuestionList questions={active} />
          </div>
        )
      }
      <h3 class="kicker mb-4">Open</h3>
      <ResearchQuestionList questions={open} />
    </section>

    <section class="grid gap-10 lg:grid-cols-[1fr_1.6fr]" aria-labelledby="disciplines-heading">
      <h2 id="disciplines-heading" class="text-2xl font-semibold sm:text-3xl">
        Why more than one discipline
      </h2>
      <div class="space-y-4 text-lg leading-relaxed text-muted">
        <p>
          A deepfake call is a technical problem, a psychological one and a
          problem of institutional procedure at the same time. Treating it as
          only one of those tends to produce answers that are correct and
          incomplete.
        </p>
        <p>
          Cybersecurity, software engineering, AI, psychology and behavioral
          science are used here as lenses, chosen by the question. Techniques
          such as OSINT or forensics may appear inside an investigation, but
          they do not define what FalconProSec studies.
        </p>
        <a href="/methods" class="link inline-block text-base">How investigations are conducted</a>
      </div>
    </section>

    <CTASection
      title="Is there a question that belongs on this list?"
      description="Suggestions are welcome, especially questions about how technology affects people that are not yet getting much attention."
      primary={{ href: '/contact?reason=investigation', label: 'Suggest a question' }}
      secondary={{ href: '/investigations', label: 'Read the investigations' }}
    />
  </div>
</Layout>
