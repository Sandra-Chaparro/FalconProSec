---
import Layout from '../../layouts/Layout.astro';
import Disclaimer from '../../components/Disclaimer.astro';
import KnowledgeLoop from '../../components/KnowledgeLoop.astro';
import ResearchQuestionList from '../../components/ResearchQuestionList.astro';
import EmptyState from '../../components/EmptyState.astro';
import InvestigationCard from '../../components/InvestigationCard.astro';
import PageHeader from '../../components/PageHeader.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { RESEARCH_QUESTIONS, TOPICS } from '../../data/taxonomy';
import { getInvestigations, pickFeatured } from '../../lib/content';

const investigations = await getInvestigations();
const lead = pickFeatured(investigations);
const rest = investigations.filter((i) => i !== lead);
const usedTopics = new Set(investigations.map((i) => i.data.topic));
// A preview of the agenda: questions being investigated first, then open ones.
const agenda = [
  ...RESEARCH_QUESTIONS.filter((q) => q.status === 'investigating'),
  ...RESEARCH_QUESTIONS.filter((q) => q.status === 'open'),
].slice(0, 6);
---

<Layout
  title="Investigations"
  description="Open investigations into how technology and AI affect human trust, safety, identity and opportunity: the question, the evidence, the experiment and what was learned."
>
  <PageHeader
    kicker="Investigations"
    title="Questions, evidence, and what it means for people"
    description="Each investigation takes one question about how technology affects people and follows the evidence: what is documented, what it suggests, what was tested, and what remains unknown. Briefs are shorter: an analysis of a public case that frames a question for a future investigation. Over time, both are meant to add up to findings."
  >
    <div class="mt-8">
      <KnowledgeLoop compact />
    </div>
    <p class="mt-4 text-sm">
      <a href="/methods" class="link">How investigations are conducted</a>
    </p>
  </PageHeader>

  <div class="container-site mt-12">
    {
      investigations.length > 0 ? (
        <>
          <form
            id="investigation-filter"
            class="mb-10 flex flex-col gap-4 sm:flex-row sm:items-center"
            role="search"
            onsubmit="return false"
          >
            <label for="investigation-search" class="sr-only">
              Search investigations
            </label>
            <input
              id="investigation-search"
              type="search"
              placeholder="Search investigations…"
              class="w-full rounded-lg border border-line bg-surface px-4 py-2.5 text-sm text-fg placeholder:text-subtle focus:border-primary/60 focus:outline-none sm:max-w-xs"
            />
            <fieldset class="flex flex-wrap gap-2">
              <legend class="sr-only">Filter by area</legend>
              <a
                href="/investigations"
                data-topic=""
                aria-pressed="true"
                class="topic-chip"
              >
                All
              </a>
              {TOPICS.filter((t) => usedTopics.has(t.slug)).map((t) => (
                <a
                  href={`/investigations/topic/${t.slug}`}
                  data-topic={t.slug}
                  aria-pressed="false"
                  class="topic-chip"
                >
                  {t.label}
                </a>
              ))}
            </fieldset>
          </form>

          {lead && (
            <div class="mb-8" data-investigation data-topic={lead.data.topic} data-search={`${lead.data.title} ${lead.data.description} ${lead.data.question} ${lead.data.tags.join(' ')}`.toLowerCase()}>
              <InvestigationCard item={lead} variant="lead" headingLevel="h2" />
            </div>
          )}
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {rest.map((item) => (
              <div
                data-investigation
                data-topic={item.data.topic}
                data-search={`${item.data.title} ${item.data.description} ${item.data.question} ${item.data.tags.join(' ')}`.toLowerCase()}
              >
                <InvestigationCard item={item} headingLevel="h2" />
              </div>
            ))}
          </div>
          <p
            id="filter-status"
            class="mt-8 text-sm text-subtle"
            role="status"
            aria-live="polite"
          />
        </>
      ) : (
        <EmptyState
          icon="search"
          title="The first investigations are in progress"
          description="Published investigations will be listed here, with their sources and any corrections. In the meantime, these are the questions on the list."
          action={{
            href: '/contact?reason=investigation',
            label: 'Suggest a question',
          }}
        />
      )
    }
  </div>

  <section class="container-site mt-24" aria-labelledby="open-questions">
    <SectionHeader
      id="open-questions"
      kicker="Research agenda"
      title="What is being explored next"
      description="Questions from the research agenda. Open questions have not been investigated yet; unresolved parts of each investigation are added here."
      link={{ href: '/research#agenda-heading', label: 'Full research agenda' }}
    />
    <ResearchQuestionList questions={agenda} />
    <p class="mt-6 text-sm text-muted">
      Have another question in mind?{' '}
      <a href="/contact?reason=investigation" class="link">Suggest it</a>.
    </p>
  </section>

  <div class="container-site mt-16">
    <Disclaimer />
  </div>
</Layout>

<style>
  .topic-chip {
    border-radius: 9999px;
    border: 1px solid var(--color-line-strong);
    padding: 0.375rem 0.875rem;
    font-size: 0.8125rem;
    color: var(--color-muted);
  }
  .topic-chip:hover {
    color: white;
  }
  .topic-chip[aria-pressed='true'] {
    border-color: var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 15%, transparent);
    color: white;
  }
</style>

<script>
  // Progressive enhancement: without JS the chips link to topic pages.
  const form = document.getElementById('investigation-filter');
  const input = document.getElementById(
    'investigation-search'
  ) as HTMLInputElement | null;
  const chips = form?.querySelectorAll<HTMLAnchorElement>('[data-topic]') ?? [];
  const items = document.querySelectorAll<HTMLElement>('[data-investigation]');
  const status = document.getElementById('filter-status');
  let activeTopic = '';

  function apply() {
    const words = (input?.value ?? '').toLowerCase().trim().split(/\s+/);
    let visible = 0;
    items.forEach((el) => {
      const matchTopic = !activeTopic || el.dataset.topic === activeTopic;
      const matchText = words.every((w) => el.dataset.search?.includes(w));
      const show = matchTopic && matchText;
      el.hidden = !show;
      if (show) visible++;
    });
    if (status) {
      status.textContent =
        visible === items.length
          ? ''
          : `Showing ${visible} of ${items.length} investigations.`;
    }
  }

  chips.forEach((chip) => {
    chip.setAttribute('role', 'button');
    chip.addEventListener('click', (e) => {
      e.preventDefault();
      activeTopic = chip.dataset.topic ?? '';
      chips.forEach((c) =>
        c.setAttribute('aria-pressed', String(c === chip))
      );
      apply();
    });
    chip.addEventListener('keydown', (e) => {
      if (e.key === ' ') {
        e.preventDefault();
        chip.click();
      }
    });
  });
  input?.addEventListener('input', apply);
</script>
