---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import EmptyState from '../../components/EmptyState.astro';
import FindingCard from '../../components/FindingCard.astro';
import InvestigationQuestion from '../../components/InvestigationQuestion.astro';
import ResearchQuestionList from '../../components/ResearchQuestionList.astro';
import InvestigationCard from '../../components/InvestigationCard.astro';
import PageHeader from '../../components/PageHeader.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { TOPICS, questionsForArea } from '../../data/taxonomy';
import { getArticles, getFindings, getInvestigations } from '../../lib/content';

export function getStaticPaths() {
  return TOPICS.map((topic) => ({
    params: { topic: topic.slug },
    props: { topic },
  }));
}

const { topic } = Astro.props;
const investigations = (await getInvestigations()).filter(
  (i) => i.data.topic === topic.slug
);
const articles = (await getArticles()).filter((a) =>
  a.data.topics.includes(topic.slug)
);
const findings = (await getFindings()).filter((f) =>
  (f.data.areas as string[]).includes(topic.slug)
);
const questions = questionsForArea(topic.slug);
const empty = investigations.length === 0 && articles.length === 0;
---

<Layout
  title={topic.label}
  description={`${topic.inquiry} Research questions, investigations and findings on ${topic.label} at FalconProSec.`}
>
  <PageHeader
    kicker="Area of inquiry"
    title={topic.label}
    description={topic.description}
    breadcrumbs={[{ label: 'Research', href: '/research' }, { label: topic.label }]}
  >
    <div class="mt-8 max-w-3xl">
      <InvestigationQuestion label="What this area is trying to understand" question={topic.inquiry} />
    </div>
    <p class="mt-6 font-mono text-xs text-subtle">
      Draws on: {topic.disciplines.join(' · ')}
    </p>
  </PageHeader>
  <div class="container-site mt-12 space-y-16">
    {
      findings.length > 0 && (
        <section aria-labelledby="findings-heading">
          <SectionHeader id="findings-heading" title="Findings" />
          <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {findings.map((f) => (
              <FindingCard item={f} />
            ))}
          </div>
        </section>
      )
    }
    {
      empty ? (
        <EmptyState
          title={`No investigations in ${topic.label} yet`}
          description="Investigations in this area will be gathered here once they are published. The questions below are what they are likely to start from."
          action={{
            href: '/contact?reason=investigation',
            label: 'Suggest a question to investigate',
          }}
        />
      ) : (
        <>
          {investigations.length > 0 && (
            <section aria-labelledby="inv-heading">
              <SectionHeader id="inv-heading" title="Investigations" />
              <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                {investigations.map((item) => (
                  <InvestigationCard item={item} />
                ))}
              </div>
            </section>
          )}
          {articles.length > 0 && (
            <section aria-labelledby="art-heading">
              <SectionHeader id="art-heading" title="Articles" />
              <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
                {articles.map((a) => (
                  <ArticleCard article={a} showSection />
                ))}
              </div>
            </section>
          )}
        </>
      )
    }
    {
      questions.length > 0 && (
        <section aria-labelledby="questions-heading">
          <SectionHeader
            id="questions-heading"
            title="Questions being explored"
            description="From the research agenda. Open questions have not been investigated yet."
            link={{ href: '/research#agenda-heading', label: 'Full research agenda' }}
          />
          <ResearchQuestionList questions={questions} showArea={false} />
        </section>
      )
    }
  </div>
</Layout>
